# Copie este arquivo para .env e preencha os valores. O .env NÃO deve ser versionado.

# --- Obrigatórias ---
# Chave da API do Google Gemini
GOOGLE_API_KEY=sua_chave_do_gemini_aqui
# Senha do PostgreSQL (use só letras e números: ela entra na URL de conexão)
POSTGRES_PASSWORD=troque_por_uma_senha_so_com_letras_e_numeros

# --- Opcionais (os valores abaixo já são os padrões) ---
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MAX_OUTPUT_TOKENS=4096
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
